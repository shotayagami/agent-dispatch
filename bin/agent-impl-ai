#!/bin/bash
# agent:impl の Codex 利用不可時に Claude へ切り替えるかを選ぶ (codex-only で切り替えない)。
# 使い方: agent-impl-ai [codex-only|default|status]
D="${XDG_STATE_HOME:-$HOME/.local/state}/agent-dispatch"
F="$D/impl-codex-only"
case "${1:-status}" in
  codex-only) mkdir -p "$D" && touch "$F" ;;
  default)    rm -f "$F" ;;
  status) ;;
  *) echo "使い方: agent-impl-ai [codex-only|default|status]" >&2; exit 2 ;;
esac
if [[ -e $F ]]; then
  echo "impl: gpt-6.2-sol → gpt-6.2-astra → gpt-6-luna。Claude へは切り替えない"
else
  echo "impl: gpt-6.2-sol → gpt-6.2-astra → gpt-6-luna。すべて利用不可なら Claude (claude-sonnet-5-5 → claude-opus-5-5 → fable) へ切り替える"
fi
