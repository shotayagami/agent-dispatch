# ~/.config/agent-dispatch/env に写して値を入れる (systemd の EnvironmentFile)
AGENT_GH_OWNER=your-github-user
AGENT_GITEA_WEB=https://gitea.example.com
AGENT_GITEA_GIT=https://gitea.internal.example.com
NTFY_AGENT_URL=https://ntfy.example.com
# NTFY_AGENT_TOPIC=agent-decisions

# agent-detect のアラートとセキュリティの検出 (空なら取得しない)
# AGENT_DETECT_ALERT_REPO=github your-github-user/infra
# AGENT_DETECT_ZBX_URL=https://zabbix.internal.example.com/api_jsonrpc.php
# AGENT_DETECT_WAZUH_SSH=ubuntu@wazuh.internal.example.com
# AGENT_DETECT_SR_URL=https://simplerisk.example.com
